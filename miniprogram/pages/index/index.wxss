.page { padding: 24rpx; }
.hint { color: #6b7280; font-size: 26rpx; margin-bottom: 16rpx; }
.input { width: 100%; min-height: 160rpx; background: #fff; border-radius: 12rpx; padding: 20rpx; box-sizing: border-box; }
.row { display: flex; align-items: center; margin-top: 20rpx; }
.label { width: 120rpx; color: #374151; }
.picker { background: #fff; padding: 12rpx 24rpx; border-radius: 8rpx; }
.cta { margin-top: 28rpx; background: #1f2937; color: #fff; border-radius: 12rpx; }
.error { color: #dc2626; margin-top: 16rpx; }
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 20rpx; }
.card-title { font-weight: 600; margin-bottom: 12rpx; }
.muted { color: #9ca3af; font-size: 24rpx; margin-top: 8rpx; }
.risk { margin-top: 8rpx; color: #92400e; }
.reply { line-height: 1.6; }
.copy { margin-top: 16rpx; font-size: 26rpx; }
.anti { background: #fef2f2; }
